# === Epoch Project .gitignore ===

# Local-only development materials (never commit)
/context/
/research/
/design/
/scratch/

# Environment files
.env
.env.*
!.env.example

# Node / Bun
node_modules/

# Python
__pycache__/
*.pyc

# Rust
target/

# Anchor
.anchor/
test-ledger/

# Next.js
.next/
dist/

# macOS
.DS_Store

# Secrets and keypairs (NEVER commit)
*.keypair.json
*keypair*.json
*wallet*.json
!evidence/*.json
id.json
keys/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
Thumbs.db

# Keeper runtime logs
keeper/logs/
*.jsonl
logs/
