# === Epoch Project .gitignore ===

# Local-only development materials (never commit)
/context/
/research/
/design/
/scratch/

# Environment files
.env
.env.*
!.env.example

# Node / Bun
node_modules/

# Python
__pycache__/
*.pyc

# Rust
target/

# Anchor
.anchor/
test-ledger/

# Next.js & Build Traces
.next/
dist/
*.tsbuildinfo


# macOS
.DS_Store

# Secrets and keypairs (NEVER commit)
*.keypair.json
*keypair*.json
*wallet*.json
!evidence/*.json
id.json
keys/
*.pem

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
Thumbs.db

# Evidence Screenshots (local verification only, never commit per Git hygiene policy)
evidence/screenshots/
*.png
*.jpg
*.jpeg

keeper/logs/
*.jsonl
logs/
.local_pids.json
.local_*
